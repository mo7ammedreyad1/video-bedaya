            heart(ctx, x, y, s = 8) {
                ctx.save();
                ctx.fillStyle = '#e1306c'; ctx.beginPath();
                ctx.moveTo(x, y + s*0.6);
                ctx.bezierCurveTo(x - s, y - s*0.2, x - s, y - s*0.9, x, y - s*0.5);
                ctx.bezierCurveTo(x + s, y - s*0.9, x + s, y - s*0.2, x, y + s*0.6);
                ctx.fill(); ctx.restore();
            }
        };

        function drawWhatsAppWallpaper(ctx, x, y, w, h) {
            ctx.save(); ctx.fillStyle = '#EFEAE2'; ctx.fillRect(x, y, w, h);
            ctx.strokeStyle = 'rgba(0, 0, 0, 0.038)'; ctx.lineWidth = 1.2; const spacing = 48;
            for (let px = x + 16; px < x + w; px += spacing) {
                for (let py = y + 16; py < y + h; py += spacing) {
                    ctx.beginPath();
                    if ((px + py) % 4 === 0) ctx.arc(px, py, 4, 0, Math.PI * 2);
                    else if ((px + py) % 3 === 0) ctx.roundRect(px - 4, py - 4, 8, 8, 2);
                    else { ctx.moveTo(px - 3, py); ctx.lineTo(px + 3, py); ctx.moveTo(px, py - 3); ctx.lineTo(px, py + 3); }
                    ctx.stroke();
                }
            }
            ctx.restore();
        }

        // Draw Unified iPhone 16 Pro Dynamic Island & Sensors
        function drawDynamicIsland(ctx, topY) {
            ctx.save();
            ctx.fillStyle = '#000000';
            ctx.beginPath();
            ctx.roundRect(-46, topY + 12, 92, 26, 13);
            ctx.fill();

            // Camera Sensor Lens Reflection
            ctx.fillStyle = '#141416';
            ctx.beginPath();
            ctx.arc(22, topY + 25, 4.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        async function prepareIdentity() {
            await document.fonts.ready;
            const [wa, ms, ig, gm] = await Promise.all([
                fetchIconify('whatsapp', 'logos:whatsapp-icon'),
                fetchIconify('messenger', 'logos:messenger'),
                fetchIconify('instagram', 'logos:instagram-icon'),
                fetchIconify('gmail', 'logos:google-gmail')
            ]);
            appLogos.whatsapp = wa;
            appLogos.messenger = ms;
            appLogos.instagram = ig;
            appLogos.gmail = gm;
        }

        // ============ MAIN RENDERING ENGINE ============
        async function drawSceneAtTime(time) {
            ctx.clearRect(0, 0, CONFIG.width, CONFIG.height);

            // 1. Studio Canvas Background (NO GRID)
            ctx.fillStyle = '#f5f5f5';
            ctx.fillRect(0, 0, CONFIG.width, CONFIG.height);

            // Ambient Center Studio Glow
            const centerGlow = ctx.createRadialGradient(
                CONFIG.width / 2, CONFIG.height / 2 + 100, 80,
