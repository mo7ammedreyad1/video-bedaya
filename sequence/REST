            reginaAvatar(ctx, x, y, r = 22) {
                ctx.save();
                ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fillStyle = '#f3d0d7'; ctx.fill();
                ctx.fillStyle = '#f6d365'; ctx.beginPath(); ctx.arc(x, y - 2, r * 0.85, Math.PI, 0); ctx.fill();
                ctx.fillStyle = '#ffdfd3'; ctx.beginPath(); ctx.arc(x, y, r * 0.6, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#333333'; ctx.beginPath(); ctx.arc(x - 4, y - 1, 2, 0, Math.PI * 2); ctx.fill();
                ctx.strokeStyle = '#e75480'; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(x, y + 2.5, 4, 0.1, Math.PI - 0.1); ctx.stroke();
                ctx.fillStyle = '#10b981'; ctx.beginPath(); ctx.arc(x - 14, y + 14, 6, 0, Math.PI * 2); ctx.fill();
                ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 2.4; ctx.stroke();
                ctx.restore();
            },
            omarAvatar(ctx, x, y, r = 22) {
                ctx.save();
                ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fillStyle = '#cbd5e1'; ctx.fill();
                ctx.fillStyle = '#fcd34d'; ctx.beginPath(); ctx.arc(x, y - 2, r * 0.5, 0, Math.PI * 2); ctx.fill();
